#!/bin/bash
# Scurtătură pentru biblioteca modelului local.
#
# Fără ea ar trebui să scrii de fiecare dată calea întreagă către python-ul din
# .venv și către script. Aici se rezolvă singură, oriunde ai fi în terminal.
#
#   ./local/biblio adauga fisier.pdf
#   ./local/biblio intreaba "ce scrie despre X?"
#
# Ca s-o poți chema de oriunde, pune în ~/.zshrc:
#   alias biblio="/Users/ionutopris/Projects/farabaliverne/local/biblio"
# apoi deschide un terminal nou. După aia merge simplu: biblio adauga ...

AICI="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="$AICI/.venv/bin/python"
[ -x "$PY" ] || PY="python3"

# Ollama trebuie să meargă, altfel erorile sunt greu de citit
if ! curl -s --max-time 5 http://localhost:11434/api/tags >/dev/null 2>&1; then
  echo "Ollama nu răspunde. Pornește aplicația Ollama și încearcă din nou." >&2
  exit 1
fi

exec "$PY" "$AICI/local/biblioteca.py" "$@"
